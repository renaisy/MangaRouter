# =============================================================================
# Seedance-Hub 环境变量模板
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 把下面所有 <请修改> 替换成你自己的随机值（密码建议用强随机串）
#   3. 重新启动：           docker compose down && docker compose up -d
#
# 生成强随机密码（命令行执行）：
#   openssl rand -hex 24
# =============================================================================

# -----------------------------------------------------------------------------
# 端口设置（如果本机端口被占用，改这里）
# -----------------------------------------------------------------------------
NEWAPI_PORT=13000
NOCODB_PORT=18080
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
ADAPTER_PORT=18008
SUBMIT_TOOL_PORT=18501
DASH_PORT=18502

# -----------------------------------------------------------------------------
# New-API（智能路由网关）
# -----------------------------------------------------------------------------
# MySQL root 密码
NEWAPI_MYSQL_ROOT_PASSWORD=<请改成强随机密码>
# 会话加密密钥（随机长字符串）
NEWAPI_SESSION_SECRET=<请改成强随机密码>
# 初始 root 令牌（登录后也可在后台重新生成）
NEWAPI_ROOT_TOKEN=<请改成强随机密码>

# -----------------------------------------------------------------------------
# NocoDB（协作平台）
# -----------------------------------------------------------------------------
NOCODB_MYSQL_ROOT_PASSWORD=<请改成强随机密码>
NOCODB_MYSQL_PASSWORD=<请改成强随机密码>
# JWT 签名密钥
NOCODB_JWT_SECRET=<请改成强随机密码>

# -----------------------------------------------------------------------------
# MinIO（对象存储）
# 用户名至少 3 位，密码至少 8 位且含字母数字
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=seedance-admin
MINIO_ROOT_PASSWORD=<请改成强随机密码至少8位>

# -----------------------------------------------------------------------------
# 以下配置供「分镜批量提交小工具」使用
# -----------------------------------------------------------------------------
# New-API 分发给团队成员的统一令牌（在 New-API 后台「令牌」页生成后填入）
SUBMIT_NEWAPI_TOKEN=<在New-API后台生成令牌后填入>
# New-API 地址（中央节点内网 IP，部署后填写，例如 http://192.168.1.50:13000）
SUBMIT_NEWAPI_BASE_URL=http://localhost:13000

# MinIO 连接信息（提交工具上传/下载文件用）
SUBMIT_MINIO_ENDPOINT=localhost:19000
SUBMIT_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
SUBMIT_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# 火山引擎方舟（如使用适配器，则填这里）
# 在 https://console.volcengine.com/ark 创建 API Key
VOLC_API_KEY=<火山引擎方舟API Key>
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# -----------------------------------------------------------------------------
# 以下配置供「计费同步脚本」使用（cost-sync/sync.py）
# 每天/定时把 New-API 消费日志汇总写入 NocoDB Costs 表，便于成本看板
# -----------------------------------------------------------------------------
# New-API 管理员令牌（需有日志读取权限）
COST_NEWAPI_BASE_URL=http://localhost:13000
COST_NEWAPI_TOKEN=<New-API管理员令牌>
# NocoDB Costs 表（用 nocodb-init 建表后，在 NocoDB URL 里取 tableId）
COST_NOCODB_BASE_URL=http://localhost:18080
COST_NOCODB_TOKEN=<NocoDB API Token>
COST_NOCODB_TABLE_ID=<Costs表的tableId，如mt_xxxxx>

# -----------------------------------------------------------------------------
# ComfyUI（专业模式，按需）
# -----------------------------------------------------------------------------
COMFYUI_BASE_URL=http://<专家电脑的ZeroTier IP>:8188
