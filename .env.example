# =============================================================================
# MangaRouter 环境变量模板（腾讯云 VPS 主部署）
# 使用方法：
#   1. 复制：  cp .env.example .env
#   2. 把所有 <请修改> 换成真实值（密码：openssl rand -hex 24）
#   3. 启动：  docker compose up -d
#   4. 反代：  编辑 deploy/Caddyfile 后 reload caddy
# =============================================================================

# -----------------------------------------------------------------------------
# 公网入口（反代域名，无尾斜杠）
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://api.your.domain

# -----------------------------------------------------------------------------
# 端口（仅本机回环；由 Caddy 对外暴露 80/443）
# -----------------------------------------------------------------------------
NEWAPI_PORT=13000
NOCODB_PORT=18080
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
ADAPTER_PORT=18008
SUBMIT_TOOL_PORT=18501
DASH_PORT=18502

# -----------------------------------------------------------------------------
# New-API
# -----------------------------------------------------------------------------
NEWAPI_MYSQL_ROOT_PASSWORD=<请改成强随机密码>
NEWAPI_SESSION_SECRET=<请改成强随机密码>
NEWAPI_ROOT_TOKEN=<请改成强随机密码>

# -----------------------------------------------------------------------------
# NocoDB
# -----------------------------------------------------------------------------
NOCODB_MYSQL_ROOT_PASSWORD=<请改成强随机密码>
NOCODB_MYSQL_PASSWORD=<请改成强随机密码>
NOCODB_JWT_SECRET=<请改成强随机密码>

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=seedance-admin
MINIO_ROOT_PASSWORD=<请改成强随机密码至少8位>

# -----------------------------------------------------------------------------
# Seedance 适配器鉴权（New-API 渠道请求须带同一 Bearer；生产必须配置）
ADAPTER_API_TOKEN=<请改成强随机密码>
ADAPTER_REQUIRE_AUTH=true

# 火山引擎方舟
VOLC_API_KEY=<火山引擎方舟API Key>
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# -----------------------------------------------------------------------------
# 分镜提交工具（容器内地址用服务名；密钥禁止暴露到浏览器）
# -----------------------------------------------------------------------------
SUBMIT_NEWAPI_TOKEN=<在New-API后台生成令牌后填入>
# 可选：按重要级使用不同令牌（未填则回退 SUBMIT_NEWAPI_TOKEN）
# SUBMIT_TOKEN_DRAFT=
# SUBMIT_TOKEN_STANDARD=
# SUBMIT_TOKEN_FINAL=

NOCODB_TOKEN=<NocoDB API Token>
STORYBOARDS_TABLE_ID=<Storyboards表的tableId，建表脚本会打印>

# 容器内连 MinIO（SDK 上传用）
SUBMIT_MINIO_ENDPOINT=minio:9000
SUBMIT_MINIO_ACCESS_KEY=seedance-admin
SUBMIT_MINIO_SECRET_KEY=<与上面MINIO_ROOT_PASSWORD相同>
SUBMIT_MINIO_SECURE=false

# 方舟可访问的公网 MinIO Host（与 Caddy s3.your.domain 一致，不要加 https://）
SUBMIT_MINIO_PUBLIC_ENDPOINT=s3.your.domain
SUBMIT_MINIO_PUBLIC_SECURE=true
# 预签名有效期（秒），默认 2 小时
SUBMIT_MINIO_PRESIGN_SECONDS=7200
# 可选：ImageUrl 额外允许的 Host（逗号分隔）；默认仅 PUBLIC_ENDPOINT
# SUBMIT_IMAGE_URL_ALLOW_HOSTS=s3.your.domain
# 可选：成片下载 Host 白名单（支持 *.volces.com）；默认火山常见域名
# SUBMIT_VIDEO_URL_ALLOW_HOSTS=*.volces.com,*.byteimg.com
# SUBMIT_MAX_VIDEO_BYTES=524288000

# ComfyUI（专家机；不用可留空）
COMFYUI_BASE_URL=

# 审核通知（可选）
# REVIEW_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx

# -----------------------------------------------------------------------------
# 计费同步 / 看板
# -----------------------------------------------------------------------------
COST_NEWAPI_TOKEN=<New-API管理员令牌>
COST_NOCODB_TOKEN=<NocoDB API Token，可与上面NOCODB_TOKEN相同>
COST_NOCODB_TABLE_ID=<Costs表的tableId，如mt_xxxxx>
# 可选：覆盖默认配额换算（New-API QuotaPerUnit，默认 500000 = 1 元）
# COST_QUOTA_PER_YUAN=500000
