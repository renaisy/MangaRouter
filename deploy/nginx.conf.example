# 可选：无域名时的 Nginx 临时反代（仅 HTTP，生产请尽快上域名+Caddy）
# 用法：把 server_name 改成 VPS 公网 IP，复制到 /etc/nginx/sites-available/

upstream newapi   { server 127.0.0.1:13000; }
upstream nocodb   { server 127.0.0.1:18080; }
upstream submit   { server 127.0.0.1:18501; }
upstream dash     { server 127.0.0.1:18502; }
upstream minio_s3 { server 127.0.0.1:19000; }

server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://newapi;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /nocodb/ {
        proxy_pass http://nocodb/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /submit/ {
        proxy_pass http://submit/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600;
    }

    location /dash/ {
        proxy_pass http://dash/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # 无域名时 MinIO 预签名 Host 很难稳定，强烈建议尽快配置 s3.域名
    location /s3/ {
        proxy_pass http://minio_s3/;
        proxy_set_header Host $host;
        proxy_buffering off;
    }
}
