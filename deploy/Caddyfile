# MangaRouter 腾讯云 VPS 反代（Caddy）—— 子域名 + 基础鉴权
#
# DNS：api / collab / submit / dash / admin / s3 → VPS 公网 IP
# MinIO 控制台默认不对公网开放（请用 SSH 隧道：ssh -L 19001:127.0.0.1:19001 vps）
#
# 生成 basicauth 哈希：caddy hash-password
# 把下面 basicauth 的 hash 换成真实值；admin 与 team 必须分用户分密码

{
	email admin@your.domain
}

api.your.domain {
	# 可选 IP 白名单示例（默认关；需要时取消注释并改 IP）：
	# @allowed { remote_ip 203.0.113.0/24 }
	# handle @allowed {
	# 	reverse_proxy 127.0.0.1:13000
	# }
	# handle { respond "Forbidden" 403 }
	reverse_proxy 127.0.0.1:13000
}

collab.your.domain {
	# 可选 IP 白名单：同上模式
	reverse_proxy 127.0.0.1:18080
}

# 提交工具：必须加鉴权（Streamlit 本身无登录）
submit.your.domain {
	basicauth {
		# 用户 哈希  ← 执行: caddy hash-password
		team $2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD
	}
	reverse_proxy 127.0.0.1:18501
}

# 成本看板：必须加鉴权（含 NocoDB 只读 Token 能力）
dash.your.domain {
	basicauth {
		team $2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD
	}
	reverse_proxy 127.0.0.1:18502
}

# 管理员渠道配置：与 team 分离的 basicauth 用户（切勿与 team 同密）
admin.your.domain {
	# 可选：在 basicauth 外包一层 @allowed remote_ip（见 api 段注释）
	basicauth {
		admin $2a$14$REPLACE_WITH_CADDY_ADMIN_HASH_PASSWORD
	}
	reverse_proxy 127.0.0.1:18503
}

# MinIO S3 API（方舟拉预签名图）。桶保持 private。
s3.your.domain {
	reverse_proxy 127.0.0.1:19000
}

# 控制台：默认注释。需要时仅经 VPN/SSH 隧道访问 127.0.0.1:19001
